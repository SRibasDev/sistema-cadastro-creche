# =============================================
# MySQL (Docker Compose)
# =============================================
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=creche_pet_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me_in_production
DB_PORT=3307

# =============================================
# Database Configuration (local/dev mode)
# =============================================
DB_URL=jdbc:mysql://localhost:3306/creche_pet_db
DB_USERNAME=app_user
DB_PASSWORD=change_me_in_production
DDL_AUTO=update

# =============================================
# JWT Configuration (MUST be >= 256-bit / 32 chars)
# =============================================
JWT_SECRET=change_me_to_a_strong_random_secret_min_32_chars
JWT_EXPIRATION=3600000

# =============================================
# Server
# =============================================
SERVER_PORT=8080

# =============================================
# CORS (origens do front-end, separadas por vírgula)
# =============================================
CORS_ALLOWED_ORIGINS=http://localhost:*

# =============================================
# Swagger (disable in production)
# =============================================
SWAGGER_ENABLED=true

# =============================================
# Perfil Spring (dev | prod). Em produção use prod.
# =============================================
SPRING_PROFILES_ACTIVE=dev