# =============================================
# Banco H2 (em arquivo) — modo local sem MySQL/Docker
# =============================================
# O banco é criado em ./data/creche-db (padrão em application.properties)
# Não é necessário MySQL nem Docker.

# Conexão H2 (padrão: jdbc:h2:file:./data/creche-db)
# Se quiser MySQL, defina DB_URL=jdbc:mysql://localhost:3306/creche_pet_db
# e as demais variáveis abaixo.
DB_URL=
DB_USERNAME=sa
DB_PASSWORD=
DDL_AUTO=create-drop

# =============================================
# JWT Configuration (MUST be >= 32 chars em produção)
# Gere um valor forte, ex.: openssl rand -base64 48
# =============================================
JWT_SECRET=uma_chave_secreta_com_pelo_menos_32_caracteres
JWT_EXPIRATION=3600000

# =============================================
# Servidor / Ambiente
# dev  => Swagger habilitado, logs verbosos
# prod => Swagger desabilitado, schema validado
# =============================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# =============================================
# CORS — origens do frontend (separadas por vírgula)
# Em produção: use o domínio real (HTTPS).
# =============================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================
# Swagger (SÓ habilite em desenvolvimento)
# No perfil 'prod' é ignorado/forçado a false.
# =============================================
SWAGGER_ENABLED=false

# =============================================
# Provisionamento do 1º ADMIN (dono)
# Ligue UMA vez no primeiro deploy (APP_BOOTSTRAP_ADMIN_ENABLED=true),
# defina email/senha, crie o dono e desligue (false).
# NUNCA versione valores reais — use segredos do ambiente.
# =============================================
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NOME=Administrador

# =============================================
# Capacidade por modalidade (vagas por dia de calendário)
# =============================================
APP_CRECHE_CAPACIDADE_CRECHE=10
APP_CRECHE_CAPACIDADE_HOTEL=20

# =============================================
# Fuso horário do container
# =============================================
TZ=America/Sao_Paulo
